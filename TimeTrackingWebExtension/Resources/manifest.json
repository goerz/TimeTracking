{
    "manifest_version": 3,
    "name": "TimeTracking",
    "description": "Records the website in the front tab, for Activity.",
    "version": "1.0",
    "background": {
        "scripts": ["background.js"],
        "persistent": false
    },
    "permissions": ["tabs", "nativeMessaging"],
    "host_permissions": ["<all_urls>"]
}
