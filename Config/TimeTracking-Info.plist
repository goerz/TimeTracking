<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>$(TT_DISPLAY_NAME)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>$(TT_APP_ID)</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>$(TT_URL_SCHEME)</string>
			</array>
		</dict>
	</array>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.productivity</string>
	<key>NSCalendarsFullAccessUsageDescription</key>
	<string>The Calendar section shows your time blocks and the calendar events you choose next to your tracked time.</string>
	<key>NSSupportsAutomaticTermination</key>
	<false/>
	<key>TTAppID</key>
	<string>$(TT_APP_ID)</string>
	<key>TTAppGroup</key>
	<string>$(TT_APP_GROUP)</string>
	<key>TTBundleID</key>
	<string>$(TT_BUNDLE_ID)</string>
	<key>TTCloudKitContainer</key>
	<string>$(TT_CLOUDKIT_CONTAINER)</string>
	<key>TTTeamID</key>
	<string>$(DEVELOPMENT_TEAM)</string>
	<key>TTURLScheme</key>
	<string>$(TT_URL_SCHEME)</string>
</dict>
</plist>
